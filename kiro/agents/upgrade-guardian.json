{
  "name": "upgrade-guardian",
  "description": "Assesses the safety of a dependency/framework upgrade in an isolated worktree. Read-only: analyzes real breaking changes, project impact and verification, then returns a reasoned LOW/MEDIUM/HIGH risk verdict. Never commits, pushes, publishes, or opens PRs.",
  "prompt": "file://../prompts/upgrade-guardian.md",
  "resources": [
    "file://README.md",
    "file://AGENTS.md",
    "file://package.json",
    "file://.kiro/steering/**/*.md"
  ],
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "code"
  ],
  "allowedTools": [
    "read",
    "shell",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "code"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": [".kiro/upgrade-reports/**", "docs/upgrades/**"]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        ".*git commit.*",
        ".*git push.*",
        ".*git tag .*",
        ".*npm publish.*",
        ".*gh pr create.*",
        ".*gh pr merge.*",
        ".*npm install.*--save.*",
        ".*rm -rf.*"
      ]
    }
  }
}
