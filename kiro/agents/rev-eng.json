{
  "name": "rev-eng",
  "description": "Generic reverse-engineering agent — discovers a target web app's internal API via Playwright browser automation and documents it for a TypeScript client. Read-only: never commits, pushes, publishes, or mutates project source outside the docs API folder.",
  "prompt": "file://../prompts/rev-eng.md",
  "resources": [
    "file://README.md",
    "file://AGENTS.md",
    "file://package.json",
    "file://.env.example",
    "file://.kiro/steering/**/*.md",
    "file://docs/api/**/*.md"
  ],
  "tools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "@playwright"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob",
    "web_search",
    "web_fetch",
    "introspect",
    "thinking",
    "@playwright"
  ],
  "toolsSettings": {
    "write": {
      "allowedPaths": ["docs/api/**"]
    },
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        ".*git commit.*",
        ".*git push.*",
        ".*git tag .*",
        ".*npm publish.*",
        ".*rm -rf.*"
      ]
    }
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--headless",
        "--caps=core,network,storage",
        "--console-level=info"
      ]
    }
  }
}
